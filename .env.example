# Copy to .env.local and add real values only there.
META_MODEL_API_KEY=
BASETEN_API_KEY=
BASETEN_MODEL=meta-models/muse-spark-open-1026
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# Standard mode; do not use a contributor model for private bills.
META_MODEL=muse-spark-1.3
PORT=4174
# Optional account-management token, only for configuring Access/Turnstile.
# Keep its value local. It may not have Worker deployment permissions.
CLOUDFLARE_API_TOKEN=
# Worker bindings. AI remains off until every control and live smoke test pass.
# Select meta or baseten on the server. Baseten supports chat only.
AI_PROVIDER=baseten
AI_ENABLED=false
SESSION_HMAC_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
ADMIN_EMAILS=
# Optional Clerk customer login (runtime configuration, independent of owner Access).
# Use development-instance values locally; production-instance values on the Worker.
CLERK_PUBLISHABLE_KEY=
# The public PEM signing key from Clerk's API keys page. No Clerk admin secret needed.
CLERK_JWT_KEY=
