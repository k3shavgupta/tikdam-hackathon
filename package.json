{
  "name": "tikdam-v1",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local server/index.mjs",
    "build": "node scripts/build-site.mjs",
    "start": "NODE_ENV=production node --env-file-if-exists=.env.local server/index.mjs",
    "test": "node --test tests/*.test.mjs tests/ui/*.test.mjs tests/evaluation/*.test.mjs",
    "test:worker": "node --test tests/worker.test.mjs tests/auth.test.mjs tests/data.test.mjs tests/admin.test.mjs",
    "test:ui": "node --test tests/app.test.mjs tests/ui/*.test.mjs",
    "dev:worker": "npm run build && wrangler dev",
    "deploy:staging": "npm run build && wrangler deploy --env \"\"",
    "deploy:production": "npm run build && wrangler deploy --env production",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:staging": "wrangler d1 migrations apply DB --remote",
    "db:production": "wrangler d1 migrations apply DB --remote --env production",
    "test:evaluation": "node --test tests/evaluation/*.test.mjs",
    "eval:offline": "node scripts/evaluation-offline.mjs",
    "eval:live": "node --env-file-if-exists=.env.local scripts/evaluation-live.mjs",
    "eval:modal": "node --env-file-if-exists=.env.local scripts/evaluation-modal.mjs",
    "build:app": "vite build"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "decimal.js": "^10.6.0",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.14",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "miniflare": "^5.20261023.3-beta",
    "vite": "^8.3.5",
    "wrangler": "^4.156.0"
  }
}
